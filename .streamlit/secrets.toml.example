# Copy to .streamlit/secrets.toml for local use, or paste into the
# Streamlit Community Cloud "Secrets" box when deploying.
#
# Only ONE provider is needed. If several are set, precedence is:
# OpenCode Go -> Gemini -> OpenAI-compatible -> local Ollama.

# --- Option A: OpenCode Go (paid subscription, OpenAI-compatible) ----------
# Get your key from the OpenCode Zen console: https://opencode.ai/auth
OPENCODE_API_KEY = "your-opencode-go-key"
# OPENCODE_MODEL = "deepseek-v4-flash"   # or glm-5.2, kimi-k2.7, deepseek-v4-pro

# --- Option B: Google Gemini (has a free tier) -----------------------------
# Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY = "your-gemini-key"
# GEMINI_MODEL = "gemini-2.0-flash"

# --- Option C: any OpenAI-compatible provider ------------------------------
# OpenAI, or free/fast alternatives such as Groq or OpenRouter.
# OPENAI_API_KEY = "sk-your-key-here"
# OPENAI_BASE_URL = "https://api.openai.com/v1"       # Groq: https://api.groq.com/openai/v1
# OPENAI_MODEL = "gpt-4o-mini"                          # Groq: llama-3.3-70b-versatile

# Require visitors to enter this code before using the app
ACRES_ACCESS_CODE = "choose-a-code"
