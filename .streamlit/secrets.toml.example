# Copy to .streamlit/secrets.toml for local use, or paste into the
# Streamlit Community Cloud "Secrets" box when deploying.

# Cloud model (used automatically when present; otherwise local Ollama is used)
OPENAI_API_KEY = "sk-your-key-here"
# Optional: any OpenAI-compatible endpoint (Groq, Together, OpenRouter, etc.)
# OPENAI_BASE_URL = "https://api.openai.com/v1"
# OPENAI_MODEL = "gpt-4o-mini"

# Require visitors to enter this code before using the app
ACRES_ACCESS_CODE = "choose-a-code"
