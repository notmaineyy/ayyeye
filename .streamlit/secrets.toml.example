# Copy to .streamlit/secrets.toml for local use, or paste into the
# Streamlit Community Cloud "Secrets" box when deploying.
#
# Only ONE provider is needed. If several are set, precedence is:
# OpenCode Go -> Gemini -> OpenAI -> local Ollama.
# (Set FORCE_PROVIDER to lock the app to a single provider.)

# --- OpenCode Go (paid subscription, OpenAI-compatible) --------------------
# Get your key from the OpenCode Zen console: https://opencode.ai/auth
OPENCODE_API_KEY = "your-opencode-go-key"
# OPENCODE_MODEL = "deepseek-v4-flash"

# --- Google Gemini (has a free tier) ---------------------------------------
# Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY = "your-gemini-key"
# GEMINI_MODEL = "gemini-2.0-flash"

# --- OpenAI-compatible (optional, e.g. OpenAI / Groq / OpenRouter) ---------
# OPENAI_API_KEY = "sk-..."
# OPENAI_BASE_URL = "https://api.openai.com/v1"
# OPENAI_MODEL = "gpt-4o-mini"

# Lock the app to a single provider: "opencode" | "gemini" | "openai".
# Leave unset while testing so the current providers keep working.
# FORCE_PROVIDER = "opencode"

# Require visitors to enter this code before using the app
ACRES_ACCESS_CODE = "choose-a-code"
